{
  "name": "nmyc-website",
  "version": "1.0.0",
  "description": "Official website for Nusa Mandiri Youth Choir (NMYC), a student choir organization at Universitas Nusa Mandiri.",
  "homepage": "https://github.com/hmif-unm/nmyc-website#readme",
  "bugs": {
    "url": "https://github.com/hmif-unm/nmyc-website/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmif-unm/nmyc-website.git"
  },
  "author": "hmif-unm",
  "type": "module",
  "main": "dev-server.ts",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "frontend:dev": "bun run --cwd frontend dev",
    "frontend:build": "npm --prefix frontend run build",
    "backend:dev": "bun --watch dev-server.ts",
    "serve": "npm --prefix frontend run build && bun dev-server.ts",
    "start": "bun dev-server.ts",
    "build": "npm --prefix frontend run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
