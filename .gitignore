# ==========================================================
# Production .gitignore - Nusa Mandiri Youth Choir (NMYC)
# ==========================================================

# Dependencies & Package Managers
node_modules/
*/node_modules/
frontend/node_modules/
.pnp
.pnp.js
.pnpm-store/

# Production Builds & Bundler Outputs
dist/
dist-ssr/
build/
.output/
.vercel/
.vite/
frontend/.vite/
frontend/.vite-temp/
*.tsbuildinfo

# Environment & Secrets (Sangat Rahasia - Jangan Pernah Commit!)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
env
*.pem
*.key
*.cert
# Kecualikan file template agar tetap ter-track di Git
!.env.example

# Database SQLite Lokal & Temporary WAL Files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
backend/data/*
!backend/data/.gitkeep

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
bun.log

# Editor & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-*
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Scratch, Testing & Temporary Files
*.tmp
*.temp
*.bak
*~
*.orig
*scrot*.png
screenshot*.png
temp/
tmp/

# Asset Dokumentasi Lokal (Semua foto wajib diambil dari repo GitHub nmyc-assets)
dokumentasi-assets/
frontend/prd-landing.md
frontend/design-landing.md
